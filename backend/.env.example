# AI provider key rotation pool (MazaoDaktari.AI.KeyRing).
# Comma-separated Gemini keys — up to 6 free-tier keys recommended to spread
# rate limits across quotas. Leave empty (with NVIDIA_API_KEY also empty) to
# run in mock mode.
GEMINI_API_KEYS=

# Single NVIDIA Build (integrate.api.nvidia.com) API key, tried after the
# Gemini keys are exhausted/rate-limited. Optional.
NVIDIA_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

PORT=4000
